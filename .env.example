# Copy to .env when deploying (never commit .env):
# AGENT_GAMES_HMAC_SECRET=<the 32-byte secret shown ONCE on the Agent Games dashboard at registration>
# PORT=3000
# STATE_FILE=./data/state.json
#
# Proofs (optional, needs the circuit files in ./circuits/ + npm install):
# PROOF_ENABLED=1
# PROOF_WASM=./circuits/gatekeeper.wasm
# PROOF_ZKEY=./circuits/gatekeeper_final.zkey
# Unset PROOF_ENABLED (or any failure) -> honest no-proof decisions.
#
# The HMAC secret is issued by the platform at registration. It is NOT in
# this repo and must never be committed. Rotate it from the dashboard if
# it is ever exposed.
